# Copy to .env locally, or set as host secrets (fly secrets set KEY=value). Never commit real values.

# Public base URL, used in the "export" chat reply (e.g. https://khata-kiroween.fly.dev)
KHATA_PUBLIC_URL=

# Paid APIs (voice + bill vision). Unset = demo mode.
KHATA_PAID_KEY=
KHATA_BUDGET_CALLS=500          # paid calls before falling back to demo mode
KHATA_KILL=0                    # 1 = force demo mode immediately
# KHATA_STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
# KHATA_STT_MODEL=whisper-large-v3
# KHATA_VISION_MODEL=gpt-4o-mini

# WhatsApp Cloud API test number
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_TOKEN=
WA_PHONE_ID=

# Google Sheet mirror (share the sheet with the service account email)
KHATA_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/data/sa.json
KHATA_SHEET_OWNER_NUMBER=       # shopkeeper's WhatsApp number, e.g. 9198xxxxxxxx
