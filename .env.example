# Copy to .env locally, or paste into Render's environment settings. Never commit real values.
# Every service here has a free tier with no card. See docs/SETUP.md for how to get each one.

# Public base URL, used in the "export" chat reply (e.g. https://khata.onrender.com)
KHATA_PUBLIC_URL=

# AI for voice + bill photos: free key from https://console.groq.com. Blank = demo mode.
GROQ_API_KEY=
KHATA_BUDGET_CALLS=500          # AI calls before falling back to demo mode
KHATA_KILL=0                    # 1 = force demo mode immediately
# Defaults (only change to swap providers):
# KHATA_STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
# KHATA_STT_MODEL=whisper-large-v3
# KHATA_VISION_URL=https://api.groq.com/openai/v1/chat/completions
# KHATA_VISION_MODEL=qwen/qwen3.8-27b

# Rate limiting behind a proxy (Render sets X-Forwarded-For)
# KHATA_CLIENT_IP_HEADER=x-forwarded-for

# Telegram bot: the shopkeeper's chat channel (token from @BotFather, free). See docs/TELEGRAM.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling           # polling locally (no tunnel); webhook on Render
TELEGRAM_WEBHOOK_SECRET=        # webhook mode only; any random string
TELEGRAM_ALLOWED_CHAT_IDS=      # optional, comma-separated; blank = anyone can use the bot
KHATA_OWNER_SALT=               # random string, e.g. `openssl rand -hex 16`; keep it stable
KHATA_SHEET_OWNER_TELEGRAM_ID=  # the number the bot replies to /id; whose ledger the Sheet mirrors

# WhatsApp Cloud API test number: optional, new Meta accounts may not get access
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_TOKEN=
WA_PHONE_ID=

# Google Sheet mirror (free Google Cloud service account; share the sheet with its email)
KHATA_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=    # whole key file contents, or use the path variable below
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
KHATA_SHEET_OWNER_NUMBER=       # shopkeeper's WhatsApp number, e.g. 9198xxxxxxxx
